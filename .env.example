# Authentication is mandatory by default. For loopback-only local development, explicitly set
# VULNFLOW_ALLOW_LOCAL_ADMIN_FALLBACK=1. Never use that setting on a remote/container deployment.
VULNFLOW_ALLOW_LOCAL_ADMIN_FALLBACK=0

# Browser users. Roles: viewer, operator, approver, admin
VULNFLOW_USERS_JSON=

# Bearer API tokens for automation. Minimum 16 characters each.
# Example: {"scanner-ci":{"token":"replace-with-long-random-token","role":"operator"}}
VULNFLOW_API_TOKENS_JSON=

# Legacy single account. Used as admin only when USERS_JSON is empty.
VULNFLOW_AUTH_USER=
VULNFLOW_AUTH_PASSWORD=

# Use 1 only when serving through HTTPS.
VULNFLOW_COOKIE_SECURE=0

# Webhook endpoints. Secrets are not stored in SQLite.
# Example: {"ops":{"url":"https://receiver.example/vulnflow","secret":"replace-long-secret","events":["*"]}}
VULNFLOW_WEBHOOKS_JSON=
VULNFLOW_WEBHOOK_INTERVAL_SECONDS=15
VULNFLOW_WEBHOOK_TIMEOUT_SECONDS=10
VULNFLOW_WEBHOOK_MAX_ATTEMPTS=5
# Remote HTTP is blocked by default. Loopback HTTP remains allowed for local testing.
VULNFLOW_WEBHOOK_ALLOW_INSECURE_HTTP=0
VULNFLOW_WEBHOOK_RETENTION_DAYS=0

# Structured log level: DEBUG, INFO, WARNING, ERROR
VULNFLOW_LOG_LEVEL=INFO

# Scheduled maintenance. 0 disables the background scheduler.
VULNFLOW_MAINTENANCE_INTERVAL_MINUTES=0

# Versioned HMAC signing keyring. Keep secrets outside SQLite and recovery bundles.
# Example: {"audit-2026q3":"replace-long-random-secret","backup-2026q3":"replace-other-long-random-secret","audit-2026q2":"old-key-kept-for-verification"}
VULNFLOW_SIGNING_KEYS_JSON=
VULNFLOW_AUDIT_ACTIVE_KEY_ID=
VULNFLOW_BACKUP_ACTIVE_KEY_ID=
# Legacy single-key variables remain supported for migration. New deployments should use the keyring above.
VULNFLOW_AUDIT_SIGNING_KEY=
VULNFLOW_BACKUP_SIGNING_KEY=
# When 1, startup fails unless the corresponding active key is configured.
VULNFLOW_AUDIT_REQUIRE_SIGNATURE=0

# Optional Ed25519 signing for publicly verifiable integrity proof ZIPs.
# Generate a key pair with: python scripts/generate_integrity_proof_key.py --key-id proof-ed25519-v1
# Keep private seed JSON outside SQLite, recovery bundles and source control.
VULNFLOW_INTEGRITY_PROOF_PRIVATE_KEYS_JSON=
VULNFLOW_INTEGRITY_PROOF_PUBLIC_KEYS_JSON=
VULNFLOW_INTEGRITY_PROOF_ACTIVE_KEY_ID=
# When 1, proof creation refuses legacy HMAC-only output.
VULNFLOW_INTEGRITY_PROOF_REQUIRE_PUBLIC_SIGNATURE=0
# Optional independent checkpoint witnesses. Keep witness private keys separate from proof/recovery keys.
VULNFLOW_INTEGRITY_WITNESS_PRIVATE_KEYS_JSON=
VULNFLOW_INTEGRITY_WITNESS_PUBLIC_KEYS_JSON=
VULNFLOW_INTEGRITY_WITNESS_ACTIVE_KEY_ID=
VULNFLOW_INTEGRITY_WITNESS_MIN_QUORUM=1
# Optional append-only checkpoint transparency log. Keep the log key separate from proof, recovery and witness keys.
VULNFLOW_INTEGRITY_TRANSPARENCY_PRIVATE_KEYS_JSON=
VULNFLOW_INTEGRITY_TRANSPARENCY_PUBLIC_KEYS_JSON=
VULNFLOW_INTEGRITY_TRANSPARENCY_ACTIVE_KEY_ID=
# When 1, public proof creation requires a published signed transparency head.
VULNFLOW_INTEGRITY_TRANSPARENCY_REQUIRE_LOG=0
# Optional independent transparency mirrors. Each mirror signs an observation of an existing signed log head.
# Keep mirror private keys in separate custody from proof, recovery, witness and transparency-log keys.
VULNFLOW_INTEGRITY_MIRROR_PRIVATE_KEYS_JSON=
VULNFLOW_INTEGRITY_MIRROR_PUBLIC_KEYS_JSON=
VULNFLOW_INTEGRITY_MIRROR_ACTIVE_KEY_ID=
VULNFLOW_INTEGRITY_MIRROR_MIN_QUORUM=1
# When 1, public proof creation requires mirror receipts that satisfy the configured quorum.
VULNFLOW_INTEGRITY_MIRROR_REQUIRE_GOSSIP=0
VULNFLOW_INTEGRITY_MIRROR_REQUIRE_CONSISTENCY=0
# 0 means keep indefinitely / do not auto-archive. Audit retention prunes only a contiguous
# prefix and advances the chain anchor; it never deletes arbitrary middle events.
VULNFLOW_AUDIT_RETENTION_DAYS=0
VULNFLOW_IMPORT_RETENTION_DAYS=0
VULNFLOW_AUTO_ARCHIVE_STALE_DAYS=0

# Optional paths
# VULNFLOW_DB=./data/vulnflow.db
# VULNFLOW_POLICY=./rules/prioritization_policy.yml
# 정책 레지스트리가 비어 있을 때 초기 ACTIVE 정책을 등록하는 bootstrap 파일입니다.

# Durable background job worker. Multiple processes may enable workers; SQLite leases prevent duplicate claims.
VULNFLOW_JOB_WORKER_ENABLED=1
VULNFLOW_JOB_WORKER_INTERVAL_SECONDS=2
VULNFLOW_LIFECYCLE_SHUTDOWN_TIMEOUT_SECONDS=5
VULNFLOW_JOB_LEASE_SECONDS=120
VULNFLOW_JOB_MAX_ATTEMPTS=3
# Completed job history retention. 0 keeps indefinitely. Purged during maintenance.
VULNFLOW_JOB_RETENTION_DAYS=30
VULNFLOW_IDEMPOTENCY_RETENTION_DAYS=30
VULNFLOW_EXECUTION_RECEIPT_RETENTION_DAYS=180

# Recovery bundle scheduling and validation. 0 disables scheduled bundles.
VULNFLOW_BACKUP_INTERVAL_HOURS=0
VULNFLOW_BACKUP_RETENTION_COUNT=10
# Recovery bundles use VULNFLOW_BACKUP_ACTIVE_KEY_ID from the signing keyring above.
# When 1, restore and validation reject unsigned recovery bundles.
VULNFLOW_BACKUP_REQUIRE_SIGNATURE=0
# Optional server-side directory for scheduled recovery bundles.
# VULNFLOW_RECOVERY_DIR=./data/backups/recovery

# Same-host multi-process coordination. Coordination DB is deliberately separate from the operational DB.
VULNFLOW_CLUSTER_COORDINATION_ENABLED=1
# Optional stable identifier. If omitted, hostname-pid-random is used.
VULNFLOW_INSTANCE_ID=
VULNFLOW_INSTANCE_HEARTBEAT_SECONDS=10
VULNFLOW_INSTANCE_TTL_SECONDS=30
VULNFLOW_SCHEDULER_LEASE_SECONDS=30
VULNFLOW_EXCLUSIVE_OPERATION_LEASE_SECONDS=300
VULNFLOW_WRITE_ACTIVITY_TTL_SECONDS=600
# Optional. Defaults beside VULNFLOW_DB as <db-stem>-coordination.db
# VULNFLOW_COORDINATION_DB=./data/vulnflow-coordination.db

# Remediation verification: consecutive full-snapshot absences required
VULNFLOW_VERIFICATION_ABSENCE_SCANS=2


# Remediation verification evidence store. Files are kept outside web static paths.
# VULNFLOW_EVIDENCE_DIR=./data/evidence
VULNFLOW_EVIDENCE_MAX_BYTES=10485760

# Evidence security scanning
VULNFLOW_EVIDENCE_SCANNER_MODE=builtin
VULNFLOW_CLAMSCAN_PATH=clamscan
VULNFLOW_EVIDENCE_SCAN_TIMEOUT_SECONDS=30
VULNFLOW_EVIDENCE_REQUIRE_CLEAN=1

# OSV supply-chain discovery
VULNFLOW_OSV_API_BASE=https://api.osv.dev
VULNFLOW_OSV_TIMEOUT_SECONDS=15
VULNFLOW_OSV_RETRIES=3
VULNFLOW_OSV_BATCH_SIZE=100

# Snapshot export artifacts. Files are stored outside web static paths and verified before download.
# VULNFLOW_EXPORT_DIR=./data/exports
# 0 keeps artifacts until an administrator expires them; otherwise maintenance removes expired files.
VULNFLOW_EXPORT_RETENTION_DAYS=7
# Managed export artifact quota and minimum filesystem reserve. 0 disables each guard.
VULNFLOW_EXPORT_QUOTA_MB=1024
VULNFLOW_EXPORT_MIN_FREE_MB=256

# Stable HMAC key for restart-stable API pagination cursors (32+ random characters recommended)
VULNFLOW_CURSOR_SIGNING_KEY=replace-with-a-long-random-cursor-key

# SQLite online maintenance observation thresholds (metrics/UI only)
VULNFLOW_DB_WAL_WARN_MB=128
VULNFLOW_DB_RECLAIM_WARN_RATIO=0.20
