VULNFLOW_PUBLIC_BASE_URL=https://vulnflow.example.com
VULNFLOW_CURSOR_SIGNING_KEY=replace-with-32-plus-random-characters
VULNFLOW_AUDIT_SIGNING_KEY=replace-with-a-separate-long-random-secret
VULNFLOW_BACKUP_SIGNING_KEY=replace-with-another-separate-long-random-secret
VULNFLOW_AUTH_SESSION_IDLE_MINUTES=60
VULNFLOW_AUTH_SESSION_MINUTES=480
VULNFLOW_BACKUP_INTERVAL_HOURS=12
# API tokens are optional. Every configured token must explicitly set projects.
# Example: {"scanner":{"token":"replace-long-random-token","role":"operator","projects":["default"]}}
VULNFLOW_API_TOKENS_JSON=
# HTTP egress for Jira and webhooks. Keep private networks disabled in production.
VULNFLOW_OUTBOUND_ALLOW_PRIVATE_NETWORKS=0
# List every approved Jira/webhook hostname. Wildcard suffixes require a subdomain.
# Example: *.atlassian.net,hooks.example.com
VULNFLOW_OUTBOUND_HOST_ALLOWLIST=api.osv.dev,www.cisa.gov,api.first.org,*.atlassian.net
VULNFLOW_OUTBOUND_MAX_RESPONSE_BYTES=1048576
VULNFLOW_INTEL_TIMEOUT_SECONDS=30
VULNFLOW_INTEL_RETRIES=3
VULNFLOW_INTEL_MAX_RESPONSE_BYTES=8388608
VULNFLOW_OSV_MAX_RESPONSE_BYTES=4194304
# SMTP has a separate policy because enterprise relays are often internal.
# Keep private networks disabled unless an exact approved relay hostname is allowlisted.
VULNFLOW_SMTP_ALLOW_PRIVATE_NETWORKS=0
VULNFLOW_SMTP_HOST_ALLOWLIST=smtp.example.com
VULNFLOW_SMTP_ALLOW_PLAIN=0

# Refuse startup when installed runtime packages differ from the packaged lock.
VULNFLOW_RUNTIME_DEPENDENCY_POLICY=enforce
